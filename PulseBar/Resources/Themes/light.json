{
  "id": "light",
  "name": "Light",
  "description": "Clean, minimal light theme with system colors",
  "version": "1.0.0",
  "author": "PulseBar Team",
  
  "popover": {
    "width": 360,
    "height": 700,
    "cornerRadius": 12,
    "shadow": {
      "enabled": true,
      "color": "#000000",
      "opacity": 0.15,
      "radius": 10,
      "offset": { "x": 0, "y": 5 }
    }
  },
  
  "layout": {
    "gridColumns": 2,
    "cardSpacing": 10,
    "sectionSpacing": 10,
    "padding": {
      "horizontal": 10,
      "vertical": 12
    }
  },
  
  "colors": {
    "background": "#FFFFFF",
    "secondaryBackground": "#F5F5F7",
    "cardBackground": "#FFFFFF",
    "primaryText": "#000000",
    "secondaryText": "#6D6D70",
    "accent": "#007AFF",
    "accentSecondary": "#5856D6",
    "success": "#34C759",
    "warning": "#FF9500",
    "error": "#FF3B30",
    "divider": "#E5E5E7"
  },
  
  "fonts": {
    "primary": {
      "family": "SF Pro Display",
      "weight": "regular",
      "size": {
        "small": 11,
        "regular": 13,
        "large": 16,
        "title": 18
      }
    },
    "monospace": {
      "family": "SF Mono",
      "weight": "regular",
      "size": {
        "small": 10,
        "regular": 12,
        "large": 14,
        "title": 16
      }
    }
  },
  
  "icons": {
    "style": "fill",
    "weight": "medium",
    "accentColor": "#007AFF",
    "size": {
      "small": 14,
      "regular": 16,
      "large": 20
    }
  },
  
  "effects": {
    "backgroundBlur": {
      "enabled": false,
      "radius": 0,
      "saturation": 1.0
    },
    "animations": {
      "enabled": true,
      "duration": 0.2,
      "curve": "easeInOut"
    },
    "glowEffect": {
      "enabled": false,
      "color": "#007AFF",
      "radius": 0,
      "opacity": 0.0
    }
  },
  
  "components": {
    "cards": {
      "style": "standard",
      "borderWidth": 0.5,
      "borderColor": "#E5E5E7",
      "cornerRadius": 8,
      "backgroundOpacity": 1.0,
      "hoverEffect": {
        "enabled": true,
        "scale": 1.02,
        "brightness": 1.05
      }
    },
    "buttons": {
      "style": "standard",
      "cornerRadius": 6,
      "borderWidth": 0,
      "hoverEffect": {
        "enabled": true,
        "brightness": 1.1
      }
    },
    "systemInfoCard": {
      "style": "standard",
      "borderGlow": false
    }
  }
}