{
  "id": "colorful",
  "name": "Colorful",
  "description": "CleanMyMac-inspired vibrant theme with dynamic gradients",
  "version": "1.0.0",
  "author": "PulseBar Team",

  "popover": {
    "width": 360,
    "height": 700,
    "cornerRadius": 20,
    "shadow": {
      "enabled": true,
      "color": "#000000",
      "opacity": 0.25,
      "radius": 15,
      "offset": { "x": 0, "y": 8 }
    }
  },

  "layout": {
    "gridColumns": 2,
    "cardSpacing": 10,
    "sectionSpacing": 10,
    "padding": {
      "horizontal": 10,
      "vertical": 12
    }
  },

  "colors": {
    "background": "#667EEA",
    "secondaryBackground": "#F093FB",
    "cardBackground": "#4ECDC4",
    "primaryText": "#FFFFFF",
    "secondaryText": "#E2E8F0",
    "accent": "#FFD700",
    "accentSecondary": "#FF6B6B",
    "success": "#48BB78",
    "warning": "#ED8936",
    "error": "#F56565",
    "divider": "#FFFFFF",
    "gradient": {
      "primary": ["#667EEA", "#764BA2"],
      "secondary": ["#F093FB", "#F5576C"],
      "accent": ["#4ECDC4", "#44A08D"]
    }
  },

  "fonts": {
    "primary": {
      "family": "Avenir Next",
      "weight": "medium",
      "size": {
        "extraSmall": 12,
        "small": 11,
        "regular": 13,
        "large": 16,
        "title": 19
      }
    },
    "monospace": {
      "family": "Avenir Next",
      "weight": "bold",
      "size": {
        "extraSmall": 11,
        "small": 10,
        "regular": 12,
        "large": 14,
        "title": 16
      }
    }
  },

  "icons": {
    "style": "fill",
    "weight": "semibold",
    "accentColor": "#FFD700",
    "size": {
      "small": 15,
      "regular": 17,
      "large": 22
    },
    "customMappings": {
      "cpu": "cpu.fill",
      "memory": "memorychip.fill",
      "storage": "externaldrive.fill",
      "network": "wifi.circle.fill",
      "battery": "battery.100.bolt.fill"
    }
  },

  "effects": {
    "backgroundBlur": {
      "enabled": false,
      "radius": 0,
      "saturation": 1.0
    },
    "animations": {
      "enabled": true,
      "duration": 0.25,
      "curve": "easeInOut"
    },
    "glowEffect": {
      "enabled": true,
      "color": "#667EEA",
      "radius": 4,
      "opacity": 0.4
    }
  },

  "components": {
    "cards": {
      "style": "gradient",
      "borderWidth": 0,
      "borderColor": "#E2E8F0",
      "cornerRadius": 16,
      "backgroundOpacity": 1.0,
      "hoverEffect": {
        "enabled": true,
        "scale": 1.05,
        "brightness": 1.15
      }
    },
    "buttons": {
      "style": "gradient",
      "cornerRadius": 12,
      "borderWidth": 0,
      "hoverEffect": {
        "enabled": true,
        "scale": 1.08,
        "brightness": 1.2
      }
    },
    "systemInfoCard": {
      "style": "gradient",
      "height": 140,
      "backgroundGradient": ["#667EEA", "#764BA2"],
      "borderGlow": false
    }
  }
}
